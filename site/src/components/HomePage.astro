---
import type { Lang } from '../data/content';
import { ui, home, embassy } from '../data/content';
import Base from '../layouts/Base.astro';
import CardGrid from './CardGrid.astro';
import LeaderList from './LeaderList.astro';

const { lang } = Astro.props as { lang: Lang };
const t = home[lang];
const u = ui[lang];

// Opening hours as "HH:MM-HH:MM" or "closed", Monday first, for the live status badge.
const hoursAttr = embassy.hours.map((h) => (h ? `${h.open}-${h.close}` : 'closed')).join(',');
const mapHref = `https://www.openstreetmap.org/?mlat=${embassy.geo.lat}&mlon=${embassy.geo.lng}#map=17/${embassy.geo.lat}/${embassy.geo.lng}`;

const hero = embassy.photos.hero;
const heroSrcset = hero.widths.map((w) => `${hero.base}-${w}.webp ${w}w`).join(', ');
const dateFmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'az-AZ', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base lang={lang} title={t.title} description={t.heroText} path="/">
  <section class="site-hero site-hero--photo" aria-labelledby="hero-heading">
    <!-- One responsive photo: the browser picks the 800px or 1600px file. fetchpriority=high because it is the LCP element. -->
    <img class="site-hero__img" src={`${hero.base}-${hero.widths[0]}.webp`} srcset={heroSrcset}
      sizes="100vw" width={hero.width} height={hero.height} alt={t.heroAlt} fetchpriority="high" decoding="async" />
    <div class="site-hero__overlay">
      <div class="grid-container">
        <h1 id="hero-heading" class="font-heading-3xl">{t.heroTitle}</h1>
        <p>{t.heroText}</p>
      </div>
    </div>
  </section>

  <section class="site-section site-section--soft" aria-labelledby="needs-heading">
    <div class="grid-container">
      <h2 id="needs-heading">{t.needTitle}</h2>
      <CardGrid cards={t.needs} lang={lang} />
      <h3 class="margin-top-4">{t.moreTitle}</h3>
      <ul class="site-tiles">
        {t.moreLinks.map((l) => (
          <li>
            <a class="site-tile" href={l.href} rel="noopener">
              <span>{l.label}</span>
              <span class="site-tile__arrow" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="site-section site-section--deep" aria-labelledby="news-heading">
    <div class="grid-container">
      <h2 id="news-heading">{t.newsTitle}</h2>
      <ul class="usa-card-group">
        {t.news.map((n) => (
          <li class="usa-card usa-card--flag-mobile tablet:grid-col-4">
            <div class="usa-card__container">
              <div class="usa-card__media">
                <div class="usa-card__img">
                  <img src={n.img} alt={n.alt} width="480" height="300" loading="lazy" decoding="async" />
                </div>
              </div>
              <div class="usa-card__header">
                <h3 class="usa-card__heading font-heading-md"><a class="usa-link" href={n.href} rel="noopener">{n.title}</a></h3>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <h3 class="margin-top-4">{t.washingtonTitle}</h3>
      <ul class="usa-collection usa-collection--condensed">
        {t.washington.map((w) => (
          <li class="usa-collection__item">
            <div class="usa-collection__body">
              <h4 class="usa-collection__heading"><a class="usa-link" href={w.href} rel="noopener">{w.title}</a></h4>
              <div class="usa-collection__meta">
                <span class="usa-collection__meta-item">{t.washingtonSource}</span>
                <time class="usa-collection__meta-item" datetime={w.date}>{dateFmt.format(new Date(w.date + 'T00:00:00'))}</time>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="site-section site-section--soft" id="contact" aria-labelledby="contact-heading">
    <div class="grid-container">
      <h2 id="contact-heading">{t.contactTitle}</h2>
      <!-- Three columns, not two. With address+map+phone+fax+social stacked in one half and a
           seven-row table in the other, the table ran out first and left a column of empty space
           beside the contact details. Splitting the details out fills the row and groups things
           that belong together. -->
      <div class="grid-row grid-gap-lg">
        <div class="tablet:grid-col-6 desktop:grid-col-5">
          <h3>{t.addressLabel}</h3>
          <address class="font-body-md" style="font-style: normal">
            {embassy.name}<br />
            {embassy.address.street}<br />
            {embassy.address.postal} {embassy.address.city}, {embassy.address.country}
          </address>
          <a class="site-map" href={mapHref} rel="noopener">
            <img src="/img/map-embassy-600.webp"
              srcset="/img/map-embassy-600.webp 600w, /img/map-embassy-1200.webp 1200w"
              sizes="(min-width: 64em) 26rem, (min-width: 40em) 32rem, 100vw" width="600" height="270"
              alt={t.mapAlt} loading="lazy" decoding="async" />
          </a>
          <p class="site-map__credit">{t.mapCredit} · <a class="usa-link" href={mapHref} rel="noopener">{t.mapLink}</a></p>
        </div>

        <div class="tablet:grid-col-6 desktop:grid-col-4">
          <h3>
            {u.hours.title}
            <span class="site-hours-status margin-left-1" hidden
              data-hours-status data-hours={hoursAttr} data-timezone={embassy.timezone}
              data-open-label={u.hours.openNow} data-closed-label={u.hours.closedNow}></span>
          </h3>
          <table class="usa-table usa-table--borderless site-hours">
            <caption class="usa-sr-only">{u.hours.title}</caption>
            <thead class="usa-sr-only"><tr><th scope="col">Day</th><th scope="col">Hours</th></tr></thead>
            <tbody>
              {embassy.hours.map((h, i) => (
                <tr>
                  <th scope="row">{u.hours.days[i]}</th>
                  <td>{h ? `${h.open} – ${h.close}` : u.hours.closed}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="font-body-2xs text-base-dark">{u.hours.timezone}</p>
        </div>

        <div class="tablet:grid-col-12 desktop:grid-col-3">
          <h3>{t.phoneLabel}</h3>
          <p class="margin-top-0"><a href={embassy.phoneHref}>{embassy.phone}</a></p>
          <h3>{t.faxLabel}</h3>
          <p class="margin-top-0">{embassy.fax}</p>

          <h3>{t.followLabel}</h3>
          <ul class="site-social">
            {embassy.social.map((sl) => (
              <li>
                <a class="site-social__link" href={sl.href} rel="noopener">
                  <span class:list={['site-social__icon', `site-social__icon--${sl.icon}`]} aria-hidden="true"></span>
                  <span>{sl.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="site-section site-section--deep" aria-labelledby="leaders-heading">
    <div class="grid-container">
      <h2 id="leaders-heading">{t.leadersTitle}</h2>
      <h3>{t.missionLeadersTitle}</h3>
      <LeaderList leaders={t.leaders} biographyLabel={t.biographyLabel} />
      <h3 class="margin-top-4">{t.governmentLeadersTitle}</h3>
      <LeaderList leaders={t.governmentLeaders} biographyLabel={t.biographyLabel} cols={3} />
    </div>
  </section>

  <section class="site-section site-section--soft" aria-labelledby="reports-heading">
    <div class="grid-container">
      <h2 id="reports-heading">{t.reportsTitle}</h2>
      <ul class="site-reports">
        {t.reports.map((r) => (
          <li>
            <a class="site-report" href={r.href} rel="noopener">
              <img src={r.img} alt="" width={r.width} height={r.height} loading="lazy" decoding="async" />
              <span>{r.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <h2 class="margin-top-5">{t.policyTitle}</h2>
      <p>{t.policyText}</p>
      <a class="usa-button usa-button--outline" href={t.policyLink.href} rel="noopener">{t.policyLink.label}</a>
    </div>
  </section>
</Base>
