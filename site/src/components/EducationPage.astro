---
import type { Lang } from '../data/content';
import { education } from '../data/content';
import ContentPage from './ContentPage.astro';
import CardGrid from './CardGrid.astro';

const { lang } = Astro.props as { lang: Lang };
const t = education[lang];
---
<ContentPage lang={lang} title={t.title} lead={t.lead} description={t.lead} path="/education/">
  <p>{t.overview}</p>

  {t.sections.map((s, i) => (
    <section class:list={['site-subsection', i % 2 === 0 ? 'site-subsection--soft' : 'site-subsection--deep']}>
      <h2 id={s.id}>{s.title}</h2>
      {s.intro && <p>{s.intro}</p>}
      <CardGrid cards={s.cards} lang={lang} cols={2} />
    </section>
  ))}
</ContentPage>
