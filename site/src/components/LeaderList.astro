---
// A group of leaders (portrait, name, role, one-line bio, link). Used for both the mission
// leaders and the U.S. government leaders, replacing the original's carousel + tabs.
import type { Link } from '../data/content';
import { embassy } from '../data/content';

interface Leader extends Link { name: string; role: string; bio: string }
const { leaders, biographyLabel, cols = 2 } = Astro.props as { leaders: Leader[]; biographyLabel: string; cols?: 2 | 3 };
const colClass = cols === 3 ? 'tablet:grid-col-6 desktop:grid-col-4' : 'tablet:grid-col-6';
---
<ul class="grid-row grid-gap-lg usa-list--unstyled">
  {leaders.map((l) => (
    <li class={colClass}>
      <div class="site-leader">
        <img class="site-leader__photo" src={embassy.photos.leaders[l.name]} alt="" width="160" height="160" loading="lazy" decoding="async" />
        <div>
          <h4 class="site-leader__name">{l.name}</h4>
          <p class="site-leader__role">{l.role}</p>
          <p>{l.bio}</p>
          <a class="usa-link usa-link--external" href={l.href} rel="noopener">{biographyLabel}: {l.name}</a>
        </div>
      </div>
    </li>
  ))}
</ul>
