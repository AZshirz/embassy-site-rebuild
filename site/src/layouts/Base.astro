---
// Base layout: everything shared by every page. Pages only provide <main> content.
import type { Lang } from '../data/content';
import { ui, embassy } from '../data/content';
import GovBanner from '../components/GovBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteAlerts from '../components/SiteAlerts.astro';
import { API_CSP_SOURCE } from '../data/api';
import { v } from '../data/asset';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page without the language prefix, e.g. "/visas/" */
  path: string;
  /** For pages search engines should not list (the 404 page): no canonical, hreflang or JSON-LD. */
  noindex?: boolean;
}
const { lang, title, description, path, noindex = false } = Astro.props;
const t = ui[lang];

// Same page in each language, for the <link hreflang> tags and the language switch.
const enPath = path;
const azPath = path === '/' ? '/az/' : `/az${path}`;
const currentPath = lang === 'en' ? enPath : azPath;
const site = Astro.site?.origin ?? '';

// Structured data so search engines understand this is a government office with hours.
const openingHours = embassy.hours
  .map((h, i) => (h ? { day: ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'][i], ...h } : null))
  .filter(Boolean)
  .map((h) => `${h!.day} ${h!.open}-${h!.close}`);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOffice',
  name: t.siteName,
  telephone: embassy.phone,
  faxNumber: embassy.fax,
  address: {
    '@type': 'PostalAddress',
    streetAddress: embassy.address.street,
    postalCode: embassy.address.postal,
    addressLocality: embassy.address.city,
    addressCountry: 'AZ',
  },
  geo: { '@type': 'GeoCoordinates', latitude: embassy.geo.lat, longitude: embassy.geo.lng },
  openingHours,
  url: site + currentPath,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Backup for the CSP that is also sent as an HTTP header. */}
    <meta http-equiv="Content-Security-Policy"
      content={`default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'${API_CSP_SOURCE}; object-src 'none'; base-uri 'self'; form-action 'self'${API_CSP_SOURCE}`} />
    <title>{title} | {t.siteName}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#162e51" />
    {noindex ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={site + currentPath} />
        <link rel="alternate" hreflang="en" href={site + enPath} />
        <link rel="alternate" hreflang="az" href={site + azPath} />
        <link rel="alternate" hreflang="x-default" href={site + enPath} />
      </>
    )}
    <link rel="icon" href="/uswds/img/favicons/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/seal.svg" type="image/svg+xml" />
    <link rel="stylesheet" href={v('/uswds/css/uswds.trimmed.min.css')} />
    <link rel="stylesheet" href={v('/css/site.css')} />
    {/* Preload the fonts the first screen uses, or it paints in fallback fonts and shifts when they
       arrive. Keep these exactly the URLs the USWDS stylesheet requests (no ?v=), or each font
       downloads twice. */}
    <link rel="preload" href="/uswds/fonts/source-sans-pro/sourcesanspro-regular-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/uswds/fonts/source-sans-pro/sourcesanspro-bold-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/uswds/fonts/merriweather/Latin-Merriweather-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <script src={v('/uswds/js/uswds-init.min.js')} is:inline></script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
    {/* Link previews say "unofficial portfolio" on purpose: a shared link card is where this copy is
       most likely to be mistaken for the real embassy site. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.ogSiteName} />
    <meta property="og:title" content={`${title} | ${t.ogSiteName}`} />
    <meta property="og:description" content={t.ogDescription} />
    {!noindex && <meta property="og:url" content={site + currentPath} />}
    <meta property="og:image" content={`${site}/img/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'az_AZ'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top">
    <a class="usa-skipnav" href="#main-content">{t.skip}</a>

    <div class="site-demo-notice" role="note">
      <div class="grid-container">
        {lang === 'en'
          ? <>Unofficial portfolio demonstration — not affiliated with the U.S. Department of State. The official site is <a href={embassy.originalSite} rel="noopener">az.usembassy.gov</a>.</>
          : <>Qeyri-rəsmi portfolio nümunəsi — ABŞ Dövlət Departamenti ilə əlaqəsi yoxdur. Rəsmi sayt: <a href={embassy.originalSite} rel="noopener">az.usembassy.gov</a>.</>}
      </div>
    </div>

    <GovBanner lang={lang} />
    <Header lang={lang} currentPath={currentPath} />
    <SiteAlerts lang={lang} />

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <Footer lang={lang} />

    <script src={v('/uswds/js/uswds.min.js')} is:inline></script>
    <script src={v('/js/site.js')} defer is:inline></script>
  </body>
</html>
